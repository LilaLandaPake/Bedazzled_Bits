# Copy to .env.local and fill in. Without these the app runs on mock data.
# Only VITE_* variables reach the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# AI keys for /api functions only (set them in Vercel project settings). Never prefix with VITE_.
# Set ONE of these. Gemini has a free tier (aistudio.google.com); Claude is paid (console.anthropic.com).
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# Optional overrides
# GEMINI_MODEL=gemini-3.5-flash-lite
# ANTHROPIC_MODEL=claude-haiku-4-5
# AI_PROVIDER=gemini   (only needed if both keys are set)
