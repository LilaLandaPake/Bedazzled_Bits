# Copy to .env.local and fill in. Without these the app runs on mock data.
# Only VITE_* variables reach the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# AI key for /api functions only (set it in Vercel project settings). Never prefix with VITE_.
ANTHROPIC_API_KEY=
# Optional model override (default: claude-haiku-4-5, chosen to stay under the 6 s limit)
# ANTHROPIC_MODEL=
